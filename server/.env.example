# Dedicated Telegram bot token from BotFather
TELEGRAM_TOKEN=

# Server-side Anthropic API key; never expose it in frontend variables
ANTHROPIC_API_KEY=

# Separate JWT signing secret. Generate with: openssl rand -hex 32
# Legacy fallback uses TELEGRAM_TOKEN; configure a dedicated secret in production.
JWT_SECRET=

# SQLite path on a persistent hosting volume
DB_PATH=/app/data/checkins.db

# Public API port (may be supplied by the hosting platform)
PORT=3001

# API bind interface: loopback for local use, 0.0.0.0 on typical hosts
HOST=0.0.0.0

# Local account-ID login. Keep disabled in production.
DEV_LOGIN=0

# Frontend origin used for bot-issued login links
FRONTEND_URL=https://life-os-tau-sand.vercel.app
